# Database connection string (Postgres)
# Example: postgres://user:password@localhost:5432/dbname

# Redis connection string (use rediss:// for TLS)
# Example for Upstash: rediss://default:token@host:6379
REDIS_URL="redis://:redis-pw@localhost:6379"

# NextAuth secret (required in production)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google Generative AI API key (required for Gemini models)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Discord OAuth credentials (for NextAuth Discord provider)
# Get from: https://discord.com/developers/applications
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Optional: Serper API key (for Google search integration)
# Get from: https://serper.dev
SERPER_API_KEY=""

# Optional: Upstash Redis REST API (alternative to ioredis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Node environment
NODE_ENV="development"
